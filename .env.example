GEMINI_API_KEY=your-key-from-https://aistudio.google.com/apikey
DATABASE_URL=postgresql://papertrail:papertrail@localhost:5433/papertrail
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
CHAT_MODEL=gemini-3.5-flash-lite

# Free-tier daily request caps are PER MODEL and vary wildly.
# gemini-3.5-flash allows only 20 generate requests/day; the -lite models allow
# far more. Start on -lite and only move up if you have a paid key.
